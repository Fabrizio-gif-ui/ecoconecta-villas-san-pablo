# ==============================================================================
# EcoConecta – Villas de San Pablo (Barranquilla, Colombia)
# Alianza Fundación Santo Domingo y Universidad Libre
# Archivo de ejemplo de variables de entorno (SIN credenciales reales).
# Copia este archivo como `.env` antes de ejecutar `docker compose up --build`.
# ==============================================================================

# --- Base de datos PostgreSQL ---
POSTGRES_DB=ecoconecta
POSTGRES_USER=ecoconecta_user
POSTGRES_PASSWORD=reemplazar_por_password_postgres
POSTGRES_PORT=5432

# --- Backend FastAPI + SQLAlchemy (Psycopg 3) ---
DATABASE_URL=postgresql+psycopg://ecoconecta_user:reemplazar_por_password_postgres@db:5432/ecoconecta
SECRET_KEY=reemplazar_por_clave_jwt_larga_y_aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTO_SEED=true
ENABLE_DEMO_QUICK_LOGIN=true
BACKEND_PORT=8000

# --- OpenAI API (Transcripción de Notas de Voz y Extracción Estructurada) ---
# Si OPENAI_API_KEY está vacía, el sistema activa automáticamente el parser
# determinístico de palabras clave para que la demo funcione sin credenciales.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_EXTRACT_MODEL=gpt-4o-mini

# --- WhatsApp Business Cloud API (Meta) ---
# Modos soportados:
#   auto       -> envía por Meta API si existen TOKEN y PHONE_NUMBER_ID; si no, guarda en modo simulado
#   simulation -> fuerza modo simulación (ideal para demos sin credenciales)
#   real       -> obliga envío real por Meta Cloud API
WHATSAPP_MODE=auto
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=57

# --- Frontend Next.js ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=/api/v1
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_APP_NAME=EcoConecta – Villas de San Pablo
